:: Widgets strangeGarden_upgrade [widget]

<<widget "SG_upgrade_simple">>
	<!--
		_args[0] = SG_state 欄位
		_args[1] = plot type
		_args[2] = 描述文字
		_args[3] = tiredness
		_args[4] = physique
	-->

	<<set _stateKey to _args[0]>>
	<<set _plotType to _args[1]>>
	<<set _text to _args[2]>>
	<<set _tiredness to _args[3] || 0>>
	<<set _physique to _args[4] || 0>>

	<<set $SG_state[_stateKey] += 1>>
	<<add_plot strangeGarden _plotType 1 small>>

	<<print _text>>

	<<if _tiredness gt 0>>
		<<tiredness _tiredness>>
		<<gtiredness>>
	<</if>>

	<<if _physique gt 0>>
		<<physique _physique>>
		<<gphysique>>
	<</if>>

	<br>
	<<getouticon>><<link [[离开|strangeGarden]]>><</link>>
<</widget>>


<<widget "SG_upgrade_locked">>
	<!--
		_args[0] = SG_state 欄位
		_args[1] = plot type
		_args[2] = 找到板條箱描述
		_args[3] = 解鎖後描述
		_args[4] = tiredness
	-->

	<<set _stateKey to _args[0]>>
	<<set _plotType to _args[1]>>
	<<set _lockedText to _args[2]>>
	<<set _unlockedText to _args[3]>>
	<<set _tiredness to _args[4] || 1>>

	<<if currentSkillValue('skulduggery') gte $lock and $SG_unlock is undefined>>

		<<print _lockedText>>
		<<tiredness _tiredness>>
		<<gtiredness>>
		<br>

		<<link [[撬锁 (0:05)|strangeGarden_upgrade]]>>
			<<pass 5>>
			<<set $SG_unlock to 1>>
		<</link>>

	<<elseif currentSkillValue('skulduggery') lt $lock>>

		你翻出一個異常沉重的板條箱，<span class="red">它的鎖看起來不是你能撬開的</span>，只好又再把它放回去。
		<<skulduggeryrequired>>
		<<tiredness 1>>
		<<gtiredness>>
		<br>

		<<getouticon>><<link [[离开|strangeGarden]]>><</link>>

	<<elseif $SG_unlock is 1>>

		<<set $SG_state[_stateKey] += 1>>
		<<unset $SG_unlock>>

		<<add_plot strangeGarden _plotType 1 small>>

		<!-- 重新掃描當前持有的可種植物品 -->
		<<SG_addPlantsSeeds>>

		<<print _unlockedText>>

		<<getouticon>><<link [[离开|strangeGarden]]>><</link>>

	<</if>>
<</widget>>

:: strangeGarden_upgrade
<<set $outside to 1>>

<<set _simpleUpgrades to {
	1: {
		state: "earth_upgrade",
		plot: "earth",
		text: "你正在努里清除雜草，雜草叢生，你費了一番功夫終於整理出一塊可供種植的土地。",
		tiredness: 3,
		physique: 2
	},

	2: {
		state: "water_upgrade",
		plot: "water",
		text: "你正在努力開挖池塘不是簡單的事，你費了一番功夫終於挖了個池塘出來。",
		tiredness: 3,
		physique: 2
	},

	3: {
		state: "bird_nest_upgrade",
		plot: "bird_nest",
		text: "你發現樹上有許多地方可以放鳥屋供鳥類築巢，你小心地爬上樹，將在工坊內找到的鳥屋固定在合適的地方。",
		tiredness: 1,
		physique: 1
	},

	4: {
		state: "wood_upgrade",
		plot: "wood",
		text: "工坊內有許多木頭，也許能拿來種香菇？你將這些木頭放在陰涼潮濕的位製。",
		tiredness: 0,
		physique: 0
	},

	5: {
		state: "hive_upgrade",
		plot: "hive",
		text: "工坊內有許多空的木箱，也許能拿來養野蜂？經過一番修整，終於做出一個蜂箱，只需要放在合適的位置就好。",
		tiredness: 0,
		physique: 0
	},

	8: {
		state: "oyster_upgrade",
		plot: "oyster",
		text: "你無聊的敲開水塘邊的珍珠貝，並往裡頭灌了點砂。",
		tiredness: 1,
		physique: 1
	},

	9: {
		state: "chicken_upgrade",
		plot: "chicken",
		text: "田邊有個雞窩，也許好好照料裡頭的雞牠們能給你提供一些雞蛋？",
		tiredness: 1,
		physique: 1
	}
}>>

<<set _lockedUpgrades to {
	6: {
		state: "cow_upgrade",
		plot: "cow",
		lockedText: '你翻出一個沉甸甸的板條箱，<span class="green">它的鎖看起來不難撬開</span>，你很想知道里頭到底放了些甚麼。',
		unlockedText: '板條箱內裝了個奇怪的東西，看起來......<span class="blue">有點像奶牛的乳房</span>，摸起來非常有彈性，現在有些乾癟，板條箱內還有其他零件，及使用說明。<br>說明書上寫著按圖組裝後，即可投入生產，雖然不明白到底如何生產，反正先組裝起來再說。<br>',
		tiredness: 1
	},

	7: {
		state: "human_upgrade",
		plot: "human",
		lockedText: '你翻出一個異常沉重的板條箱，<span class="green">它的鎖看起來不難撬開</span>，你很想知道里頭到底放了些甚麼。',
		unlockedText: '板條箱內裝了個奇怪的東西，看起來......<span class="blue">有著人類外型</span>，摸起來非常有彈性，現在有些乾癟，板條箱內還有其他零件，及使用說明。<br>說明書上寫著按圖組裝後，即可投入生產，雖然不明白到底如何生產，反正先組裝起來再說。<br>',
		tiredness: 2
	},

	10: {
		state: "kitchen_upgrade",
		plot: "kitchen",
		lockedText: '你翻出一個異常沉重的板條箱，<span class="green">它的鎖看起來不難撬開</span>，你很想知道里頭到底放了些甚麼。',
		unlockedText: '板條箱內裝了台奇特的設備，板條箱內還有其他零件，及使用說明。<br>說明書上寫著按圖組裝後，即可投入生產，雖然不明白到底如何生產，反正先組裝起來再說。<br>',
		tiredness: 2
	},

	11: {
		state: "river_upgrade",
		plot: "river",
		lockedText: '你翻出一個異常沉重的板條箱，<span class="green">它的鎖看起來不難撬開</span>，你很想知道里頭到底放了些甚麼。',
		unlockedText: '板條箱內裝了台奇特的設備，板條箱內還有其他零件，及使用說明。<br>說明書上寫著按圖組裝後，即可投入生產，雖然不明白到底如何生產，反正先組裝起來再說。<br>',
		tiredness: 2
	},

	12: {
		state: "sea_upgrade",
		plot: "sea",
		lockedText: '你翻出一個異常沉重的板條箱，<span class="green">它的鎖看起來不難撬開</span>，你很想知道里頭到底放了些甚麼。',
		unlockedText: '板條箱內裝了台奇特的設備，板條箱內還有其他零件，及使用說明。<br>說明書上寫著按圖組裝後，即可投入生產，雖然不明白到底如何生產，反正先組裝起來再說。<br>',
		tiredness: 2
	}
}>>

<<if $SG_upgrade_refresh is undefined>>

	<<if _simpleUpgrades[$SG_upgrade_type]>>

		<<set _upgrade to _simpleUpgrades[$SG_upgrade_type]>>

		<<SG_upgrade_simple
			_upgrade.state
			_upgrade.plot
			_upgrade.text
			_upgrade.tiredness
			_upgrade.physique
		>>

	<<elseif _lockedUpgrades[$SG_upgrade_type]>>

		<<set _upgrade to _lockedUpgrades[$SG_upgrade_type]>>

		<<SG_upgrade_locked
			_upgrade.state
			_upgrade.plot
			_upgrade.lockedText
			_upgrade.unlockedText
			_upgrade.tiredness
		>>

	<</if>>

<<elseif $SG_upgrade_refresh is 1>>

	<<unset $SG_upgrade_refresh>>

	<<set _upgradePlots to [
		["earth_upgrade", "earth"],
		["water_upgrade", "water"],
		["oyster_upgrade", "oyster"],
		["bird_nest_upgrade", "bird_nest"],
		["chicken_upgrade", "chicken"],
		["wood_upgrade", "wood"],
		["hive_upgrade", "hive"],
		["cow_upgrade", "cow"],
		["human_upgrade", "human"],
		["kitchen_upgrade", "kitchen"],
		["river_upgrade", "river"],
		["sea_upgrade", "sea"]
	]>>

	<<plots_init strangeGarden 1 earth 1 small>>

	<!-- 原本固定的一個水池 -->
	<<add_plot strangeGarden water 1 small>>

	<<for _upgrade range _upgradePlots>>

		<<set _count to $SG_state[_upgrade[0]] || 0>>

		<<for _i to 0; _i lt _count; _i++>>
			<<add_plot strangeGarden _upgrade[1] 1 small>>
		<</for>>

	<</for>>

	<<getouticon>><<link [[离开|strangeGarden]]>><</link>>

<</if>>